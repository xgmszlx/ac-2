<!-- ExplORB-SLAM localization-observability line: move_base + SLAM frontend.

   Content of robot_description/launch/include/move_base_ORBSLAM.launch with only
   platform substitutions:
     * the costmap parameter files come from explorb_scenarios/param (absolute scan
       topic and the TurtleBot3 Waffle footprint);
     * everything about the ORB-SLAM frontend is byte-identical to the author file.
-->
<launch>

    <arg name="namespace"/>
    <arg name="paused" default="false"/>

    <param name="use_sim_time" value="true" />

    <node name="orb_slam2_rgbd" pkg="orb_slam2_ros" type="orb_slam2_ros_rgbd" output="screen" respawn="false">
        <!-- The platform publishes /camera/... and /odom at the root namespace
             (see the note in sim_house.launch), so no remapping is needed here. -->

        <param name="publish_pointcloud" type="bool" value="true" />
        <param name="publish_pose" type="bool" value="true" />
        <param name="localize_only" type="bool" value="false" />
        <param name="reset_map" type="bool" value="false" />

        <param name="pointcloud_frame_id" type="string" value="map" />
        <param name="camera_frame_id" type="string" value="base_footprint" />
        <param name="target_frame_id" type="string" value="base_footprint" />

        <param name="load_map" type="bool" value="false" />
        <param name="map_file" type="string" value="map.bin" />
        <param name="voc_file" type="string" value="$(find orb_slam2_ros)/orb_slam2/Vocabulary/ORBvoc.txt" />
        <param name="min_num_kf_in_map" type="int" value="5" />

        <param name="/ORBextractor/nFeatures" type="int" value="1000" />
        <param name="/ORBextractor/scaleFactor" type="double" value="1.2" />
        <param name="/ORBextractor/nLevels" type="int" value="8" />
        <param name="/ORBextractor/iniThFAST" type="int" value="20" />
        <param name="/ORBextractor/minThFAST" type="int" value="7" />

        <param name="camera_fps" type="int" value="30" />
        <param name="camera_bf" type="int" value="72" />
        <param name="camera_rgb_encoding" type="bool" value="true" />
        <param name="ThDepth" type="double" value="30.0" />
        <param name="depth_map_factor" type="double" value="1.0" />
        <param name="load_calibration_from_cam" type="bool" value="true" />
    </node>

    <group ns="$(arg namespace)">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base_node" output="screen">
            <!-- platform: the TurtleBot3 diff-drive plugin listens on /cmd_vel (root namespace) -->
            <remap from="cmd_vel" to="/cmd_vel"/>
            <remap from="move_base_node/TebLocalPlannerROS/global_plan" to="move_base_node/global_plan"/>
            <remap from="move_base_node/TebLocalPlannerROS/local_plan" to="move_base_node/local_plan"/>

            <rosparam file="$(find explorb_scenarios)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
            <rosparam file="$(find explorb_scenarios)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
            <rosparam file="$(find explorb_scenarios)/param/local_costmap_params.yaml" command="load" />
            <rosparam file="$(find explorb_scenarios)/param/global_costmap_params.yaml" command="load" />
            <rosparam file="$(find explorb_scenarios)/param/base_global_planner_params.yaml" command="load" />

            <!-- Time elastic band local planner -->
            <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
            <param name="controller_frequency" value="10.0" />
            <rosparam file="$(find explorb_scenarios)/param/teb_base_local_planner_params.yaml" command="load" />

            <param name="max_planning_retries" value="1"/>
            <param name="recovery_behavior_enabled" value="false"/>
            <rosparam file="$(find explorb_scenarios)/param/recovery_behaviors.yaml" command="load" />
        </node>
    </group>

</launch>
