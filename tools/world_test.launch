<launch>
  <arg name="world" default="$(find explorb_scenarios)/worlds/w_ctrl.world"/>
  <arg name="urdf" default="$(find explorb_scenarios)/urdf/explorb_robot.urdf.xacro"/>
  <arg name="models" default="$(find robot_description)/launch/include/models/aws/bookstore"/>
  <env name="GAZEBO_MODEL_PATH" value="$(arg models):$(env GAZEBO_MODEL_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
  </include>
  <param name="robot_description" command="$(find xacro)/xacro $(arg urdf)"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" args="-urdf -model robot_1 -x 0.0 -y 0.0 -z 0.02 -param robot_description"/>
</launch>
